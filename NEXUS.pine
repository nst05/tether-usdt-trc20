//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  N E X U S  ·  7-Layer Adaptive Market Intelligence
//  7 независимых слоёв · детектор режима рынка · адаптивные веса
//  Hurst-прокси · рыночный пульс · NEXUS EVENT при 5+ слоях в одну сторону
// ─────────────────────────────────────────────────────────────────────────────
indicator("NEXUS — 7-Layer Intelligence", "NEXUS", overlay=false, max_labels_count=30)

// ══════════════════════════════════════════════════════════════════════════════
//  НАСТРОЙКИ
// ══════════════════════════════════════════════════════════════════════════════
w1 = input.float(1.5, "L1 Тренд",        minval=0, maxval=5, step=0.1, group="Веса слоёв")
w2 = input.float(1.2, "L2 Геометрия",    minval=0, maxval=5, step=0.1, group="Веса слоёв")
w3 = input.float(1.0, "L3 Давление",     minval=0, maxval=5, step=0.1, group="Веса слоёв")
w4 = input.float(1.0, "L4 Корреляции",   minval=0, maxval=5, step=0.1, group="Веса слоёв")
w5 = input.float(0.8, "L5 Макро",        minval=0, maxval=5, step=0.1, group="Веса слоёв")
w6 = input.float(0.8, "L6 Цикл (крипто)",minval=0, maxval=5, step=0.1, group="Веса слоёв")
w7 = input.float(1.2, "L7 Разворот",     minval=0, maxval=5, step=0.1, group="Веса слоёв")

nexusThr = input.int(5,    "NEXUS EVENT: мин. слоёв", minval=3, maxval=7,   group="Сигналы")
scoreThr = input.float(40, "NEXUS EVENT: мин. счёт ±",minval=15,maxval=90,  group="Сигналы")
atrLen   = input.int(14,   "ATR период",  minval=2,             group="Риск")
slMul    = input.float(1.5,"SL = ATR ×",  minval=0.2, step=0.1, group="Риск")
rr1      = input.float(2.0,"TP R:R",      minval=0.5, step=0.1, group="Риск")
emaF     = input.int(21,   "EMA быстрая", minval=2,             group="Тренд")
emaS     = input.int(89,   "EMA медленная",minval=5,            group="Тренд")
corrLen  = input.int(50,   "Корреляция окно",minval=10,         group="Корреляции")
swLen    = input.int(10,   "SMC свинг",   minval=2,             group="Геометрия")
divLen   = input.int(14,   "Дивергенция", minval=5,             group="Разворот")

sym1 = input.symbol("TVC:DXY",         "DXY",   group="Корреляции")
sym2 = input.symbol("SP:SPX",          "SPX",   group="Корреляции")
sym3 = input.symbol("TVC:GOLD",        "Gold",  group="Корреляции")
sym4 = input.symbol("BINANCE:BTCUSDT", "BTC",   group="Корреляции")
symY = input.symbol("TVC:US10Y",       "US10Y", group="Макро")
symV = input.symbol("CBOE:VIX",        "VIX",   group="Макро")

// ══════════════════════════════════════════════════════════════════════════════
//  УТИЛИТЫ
// ══════════════════════════════════════════════════════════════════════════════
nz0(x)    => na(x) ? 0.0 : x
clamp1(x) => math.max(-1.0, math.min(1.0, x))
soft(x,s) => s == 0 ? math.sign(x) : clamp1(x / s)
sc(v)     => v > 0.1 ? color.new(color.teal, 20) : v < -0.1 ? color.new(color.red, 30) : color.new(color.gray, 55)
br(v)     => math.abs(v) > 0.65 ? "████" : math.abs(v) > 0.40 ? "███ " : math.abs(v) > 0.20 ? "██  " : math.abs(v) > 0.05 ? "█   " : "─   "

// ══════════════════════════════════════════════════════════════════════════════
//  БАЗОВЫЕ ИНДИКАТОРЫ
// ══════════════════════════════════════════════════════════════════════════════
_atr = ta.atr(atrLen)
_ef  = ta.ema(close, emaF)
_es  = ta.ema(close, emaS)
_rsi = ta.rsi(close, 14)
[_ml, _sl2, _hist] = ta.macd(close, 12, 26, 9)
_roc = ta.roc(close, 20)
[diP, diM, adxV] = ta.dmi(14, 14)

atrMa    = ta.sma(_atr, 50)
isTrend  = adxV > 25
isVolat  = _atr > atrMa * 1.5
isSqueeze = _atr < atrMa * 0.7

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 1 — TREND ENGINE  (адаптивный: вес растёт в тренде, падает в флете)
// ══════════════════════════════════════════════════════════════════════════════
layer1 = clamp1((close>_ef?0.25:-0.25) + (_ef>_es?0.25:-0.25) + clamp1((_rsi-50)/25)*0.20 + soft(_hist,_atr*0.5)*0.15 + soft(_roc,5.0)*0.15)

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 2 — MARKET GEOMETRY  (BOS/CHoCH + sweep + Hurst-прокси)
//  Variance Ratio > 1 = рынок трендовый (persistent), < 1 = mean-reverting
// ══════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow(low,  swLen, swLen)
var float swH = na
var float swL = na
if not na(ph)
    swH := ph
if not na(pl)
    swL := pl
var int sBias = 0
if not na(swH) and close > swH
    sBias := 1
if not na(swL) and close < swL
    sBias := -1
bSweep  = not na(swL) and low  < swL and close > swL
brSweep = not na(swH) and high > swH and close < swH

var1w = ta.variance(ta.change(close),    50)
var4w = ta.variance(ta.change(close, 4), 50)
vRatio = var1w > 0 ? var4w / (4.0 * var1w) : 1.0
hurstProxy = clamp1((vRatio - 1.0) * 3.0)

layer2 = clamp1(sBias * 0.55 + (bSweep ? 0.25 : brSweep ? -0.25 : 0.0) + hurstProxy * 0.20)

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 3 — PRESSURE INTELLIGENCE  (давление баров + тело свечи)
// ══════════════════════════════════════════════════════════════════════════════
barRng   = high - low
closePos = barRng > 0 ? (close - low) / barRng : 0.5
pressure = ta.ema(closePos * 2.0 - 1.0, 14)
bodyAbs  = math.abs(close - open)
bodyScr  = clamp1((_atr > 0 ? math.min(bodyAbs / _atr, 1.5) : 0.5) * (close > open ? 1.0 : -1.0) * 0.5)
layer3   = clamp1(pressure * 0.65 + bodyScr * 0.35)

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 4 — CORRELATION MATRIX  (DXY / SPX / Gold / BTC)
// ══════════════════════════════════════════════════════════════════════════════
a1c = request.security(sym1, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a1e = request.security(sym1, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a2c = request.security(sym2, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a2e = request.security(sym2, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a3c = request.security(sym3, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a3e = request.security(sym3, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a4c = request.security(sym4, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a4e = request.security(sym4, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

cBias(ac, ae) => na(ac) or na(ae) ? 0.0 : clamp1(nz0(ta.correlation(close, ac, corrLen)) * (ac > ae ? 1.0 : -1.0))
layer4 = clamp1((cBias(a1c,a1e) + cBias(a2c,a2e) + cBias(a3c,a3e) + cBias(a4c,a4e)) / 4.0)

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 5 — MACRO BACKDROP  (US10Y + VIX)
// ══════════════════════════════════════════════════════════════════════════════
yNow = request.security(symY, "D", close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
yMa  = request.security(symY, "D", ta.sma(close,20), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vNow = request.security(symV, "D", close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vMa  = request.security(symV, "D", ta.sma(close,20), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
yScr = na(yNow) or na(yMa) or yMa == 0 ? 0.0 : clamp1(-(yNow-yMa) / (yMa*0.05))
vScr = na(vNow) or na(vMa) or vMa == 0 ? 0.0 : clamp1(-(vNow-vMa) / (vMa*0.15))
layer5 = clamp1((yScr + vScr) / 2.0)

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 6 — CYCLE ORACLE  (BTC 200W SMA + TOTAL капитализация)
// ══════════════════════════════════════════════════════════════════════════════
btcW   = request.security("BINANCE:BTCUSDT", "W", close,             lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
btc200 = request.security("BINANCE:BTCUSDT", "W", ta.sma(close,200), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
totW   = request.security("CRYPTOCAP:TOTAL", "W", close,             lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
totE   = request.security("CRYPTOCAP:TOTAL", "W", ta.ema(close,13),  lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
btcCyc = na(btcW) or na(btc200) or btc200 == 0 ? 0.0 : clamp1((btcW>btc200?0.5:-0.5) + clamp1((btcW-btc200)/btc200*2.0)*0.5)
totTr  = na(totW) or na(totE) ? 0.0 : totW > totE ? 0.5 : -0.5
layer6 = clamp1(btcCyc * 0.7 + totTr * 0.3)

// ══════════════════════════════════════════════════════════════════════════════
//  СЛОЙ 7 — REVERSAL RADAR  (RSI дивергенция · Pin Bar · Engulf · Stoch)
// ══════════════════════════════════════════════════════════════════════════════
rsiH  = ta.highest(_rsi, divLen)
rsiL  = ta.lowest(_rsi,  divLen)
prH   = ta.highest(high,  divLen)
prL   = ta.lowest(low,   divLen)
bDiv  = low  <= prL and _rsi > rsiL and _rsi < 50
brDiv = high >= prH and _rsi < rsiH and _rsi > 50

bodyS  = math.abs(close - open)
upW    = high - math.max(close, open)
dwW    = math.min(close, open) - low
bPin   = bodyS > 0 and dwW >= bodyS * 2.0 and upW < bodyS
brPin  = bodyS > 0 and upW >= bodyS * 2.0 and dwW < bodyS

prevB  = math.abs(close[1] - open[1])
currB  = math.abs(close - open)
bEng   = close>open  and close[1]<open[1] and close>open[1] and open<close[1] and currB>prevB
brEng  = close<open  and close[1]>open[1] and close<open[1] and open>close[1] and currB>prevB

_stK   = ta.sma(ta.stoch(close, high, low, 14), 3)
stBull = _stK < 20 and _stK > _stK[1]
stBear = _stK > 80 and _stK < _stK[1]
stBias = _stK < 30 ? 0.5 : _stK > 70 ? -0.5 : 0.0
stFull = stBull ? 1.0 : stBear ? -1.0 : stBias

layer7 = clamp1((bDiv?1.0:brDiv?-1.0:0.0)*0.35 + (bPin?1.0:brPin?-1.0:0.0)*0.20 + (bEng?1.0:brEng?-1.0:0.0)*0.15 + stFull*0.30)

// ══════════════════════════════════════════════════════════════════════════════
//  АДАПТИВНЫЕ ВЕСА  (в тренде усиливается L1, в флете — L7)
// ══════════════════════════════════════════════════════════════════════════════
aw1 = isTrend ? w1 * 1.3 : w1 * 0.8
aw7 = isTrend ? w7 * 0.7 : w7 * 1.3
wSum  = math.max(aw1 + w2 + w3 + w4 + w5 + w6 + aw7, 0.0001)
rawS  = (layer1*aw1 + layer2*w2 + layer3*w3 + layer4*w4 + layer5*w5 + layer6*w6 + layer7*aw7) / wSum
nScore = nz0(rawS) * 100.0

// ══════════════════════════════════════════════════════════════════════════════
//  ALIGNMENT — сколько слоёв согласовано с направлением итогового счёта
// ══════════════════════════════════════════════════════════════════════════════
sDir = math.sign(rawS)
a1ok = math.sign(layer1) == sDir and layer1 != 0 ? 1 : 0
a2ok = math.sign(layer2) == sDir and layer2 != 0 ? 1 : 0
a3ok = math.sign(layer3) == sDir and layer3 != 0 ? 1 : 0
a4ok = math.sign(layer4) == sDir and layer4 != 0 ? 1 : 0
a5ok = math.sign(layer5) == sDir and layer5 != 0 ? 1 : 0
a6ok = math.sign(layer6) == sDir and layer6 != 0 ? 1 : 0
a7ok = math.sign(layer7) == sDir and layer7 != 0 ? 1 : 0
alignment = a1ok + a2ok + a3ok + a4ok + a5ok + a6ok + a7ok

// ══════════════════════════════════════════════════════════════════════════════
//  MARKET PULSE  (насколько "живой" рынок: ATR + RSI-мобильность)
// ══════════════════════════════════════════════════════════════════════════════
atrRank  = ta.percentrank(_atr, 100)
rsiMob   = ta.stdev(_rsi, 20)
rsiMRank = ta.percentrank(rsiMob, 100)
pulse    = math.round((atrRank + rsiMRank) / 2.0)

// ══════════════════════════════════════════════════════════════════════════════
//  CONVICTION  (сколько баров подряд alignment >= порога)
// ══════════════════════════════════════════════════════════════════════════════
var int conviction = 0
if alignment >= nexusThr and math.abs(nScore) >= 25
    conviction := conviction + 1
else
    conviction := 0

// ══════════════════════════════════════════════════════════════════════════════
//  NEXUS EVENT
// ══════════════════════════════════════════════════════════════════════════════
var int lastState = 0
nexusBuy  = nScore >=  scoreThr and alignment >= nexusThr and lastState <= 0
nexusSell = nScore <= -scoreThr and alignment >= nexusThr and lastState >= 0
if nexusBuy
    lastState := 1
if nexusSell
    lastState := -1

// ── SL / TP ──────────────────────────────────────────────────────────────────
var float lEntry = na
var float lSL    = na
var float lTP    = na
var int   lDir   = 0
if nexusBuy or nexusSell
    lDir   := nexusBuy ? 1 : -1
    lEntry := close
    lSL    := nexusBuy ? close - _atr * slMul : close + _atr * slMul
    riskV  = math.abs(lEntry - lSL)
    lTP    := nexusBuy ? lEntry + riskV * rr1 : lEntry - riskV * rr1

// ── Reversal signs string (живые) ───────────────────────────────────────────
revNow = ""
revNow := bDiv   ? revNow + "↑Div "  : revNow
revNow := brDiv  ? revNow + "↓Div "  : revNow
revNow := bPin   ? revNow + "↑Pin "  : revNow
revNow := brPin  ? revNow + "↓Pin "  : revNow
revNow := bEng   ? revNow + "↑Eng "  : revNow
revNow := brEng  ? revNow + "↓Eng "  : revNow
revNow := stBull ? revNow + "↑Stc "  : revNow
revNow := stBear ? revNow + "↓Stc "  : revNow
revNow := revNow == "" ? "─" : revNow

// ══════════════════════════════════════════════════════════════════════════════
//  ВИЗУАЛИЗАЦИЯ
// ══════════════════════════════════════════════════════════════════════════════
nColor = nScore > 70 ? color.new(color.lime,0) : nScore > 40 ? color.new(color.teal,0) : nScore > 0 ? color.new(color.green,40) : nScore > -40 ? color.new(color.orange,20) : nScore > -70 ? color.new(color.red,10) : color.new(color.maroon,0)

// Основная линия счёта
plot(nScore,        "NEXUS Score",   color=nColor,                       linewidth=3)
// Тонкие линии слоёв
plot(layer1 * 80,  "L1 Тренд",      color=color.new(color.blue,   65),  linewidth=1)
plot(layer7 * 80,  "L7 Разворот",   color=color.new(color.purple, 65),  linewidth=1)
plot(layer2 * 80,  "L2 Геометрия",  color=color.new(color.yellow, 70),  linewidth=1)

// Фон режима рынка
regBg = isTrend and not isVolat ? color.new(color.blue, 95) : isVolat ? color.new(color.red, 91) : isSqueeze ? color.new(color.green, 95) : color.new(color.gray, 97)
bgcolor(regBg)
// Подсветка NEXUS-зоны
bgcolor(alignment >= nexusThr ? (nScore > 0 ? color.new(color.green, 88) : color.new(color.red, 88)) : na)

// Уровни
hline( 70, "NEXUS +",     color=color.new(color.green,  30), linestyle=hline.style_dashed,  linewidth=2)
hline( 40, "+40",         color=color.new(color.teal,   60), linestyle=hline.style_dotted)
hline(  0, "0",           color=color.new(color.gray,   40), linestyle=hline.style_solid)
hline(-40, "−40",         color=color.new(color.orange, 60), linestyle=hline.style_dotted)
hline(-70, "NEXUS −",     color=color.new(color.red,    30), linestyle=hline.style_dashed,  linewidth=2)

// ── NEXUS EVENT labels ───────────────────────────────────────────────────────
var label[] lblArr = array.new_label()
if nexusBuy or nexusSell
    slTxt  = na(lSL) ? "" : "  SL " + str.tostring(lSL, format.mintick)
    tpTxt  = na(lTP) ? "" : "  TP " + str.tostring(lTP, format.mintick)
    lTxt   = (nexusBuy ? "⚡ NEXUS LONG" : "⚡ NEXUS SHORT") + "\n" + str.tostring(alignment) + "/7 слоёв" + slTxt + tpTxt
    lStyle = nexusBuy ? label.style_label_up : label.style_label_down
    lYpos  = nexusBuy ? -88.0 : 88.0
    lClr   = nexusBuy ? color.new(color.green, 10) : color.new(color.red, 10)
    lbl    = label.new(bar_index, lYpos, lTxt, style=lStyle, color=lClr, textcolor=color.white, size=size.normal)
    array.push(lblArr, lbl)
    if array.size(lblArr) > 10
        label.delete(array.shift(lblArr))

// ══════════════════════════════════════════════════════════════════════════════
//  ТАБЛИЦА
// ══════════════════════════════════════════════════════════════════════════════
dirStr = nScore > 70 ? "⚡ NEXUS LONG" : nScore > 40 ? "▲ БЫЧИЙ" : nScore > 0 ? "↗ СЛАБЫЙ БЫК" : nScore > -40 ? "↘ СЛАБЫЙ МЕДВЕДЬ" : nScore > -70 ? "▼ МЕДВЕЖИЙ" : "⚡ NEXUS SHORT"
dirClr = nScore > 40 ? color.new(color.green,10) : nScore < -40 ? color.new(color.red,10) : color.new(color.gray,45)
regStr = isTrend and not isVolat ? "ТРЕНД" : isVolat ? "ВОЛАТ." : isSqueeze ? "НАКОПЛ." : "ФЛЕТ"
regClr = isTrend and not isVolat ? color.new(color.blue,25) : isVolat ? color.new(color.red,20) : isSqueeze ? color.new(color.teal,20) : color.new(color.gray,50)

algBar = alignment >= 7 ? "●●●●●●●" : alignment >= 6 ? "●●●●●●○" : alignment >= 5 ? "●●●●●○○" : alignment >= 4 ? "●●●●○○○" : alignment >= 3 ? "●●●○○○○" : alignment >= 2 ? "●●○○○○○" : alignment >= 1 ? "●○○○○○○" : "○○○○○○○"
algStr = str.tostring(alignment) + "/7  " + algBar + (alignment >= nexusThr ? " ⚡" : "")
algClr = alignment >= nexusThr ? color.new(color.green,20) : alignment >= 4 ? color.new(color.teal,35) : color.new(color.gray,55)

if barstate.islast
    var table t = table.new(position.top_left, 2, 14, border_width=1, frame_color=color.new(color.gray,30), frame_width=1, bgcolor=color.new(color.black,10))

    // 0 — Шапка
    table.cell(t, 0, 0, "NEXUS  7L",  text_color=color.white,  text_size=size.small,  bgcolor=color.new(color.navy, 0))
    table.cell(t, 1, 0, dirStr,        text_color=color.white,  text_size=size.normal, bgcolor=dirClr)

    // 1 — Счёт
    gRnd  = math.round(nScore)
    gSign = gRnd >= 0 ? "+" : ""
    table.cell(t, 0, 1, "Счёт",        text_color=color.silver, text_size=size.small,  bgcolor=color.new(color.black,40))
    table.cell(t, 1, 1, gSign + str.tostring(gRnd) + " / 100", text_color=color.white, text_size=size.normal, bgcolor=sc(nScore/100))

    // 2 — Режим + Пульс
    pulseStr = "Пульс " + str.tostring(pulse) + "%  " + (pulse > 70 ? "горячий" : pulse > 40 ? "средний" : "тихий")
    table.cell(t, 0, 2, regStr,         text_color=color.white,  text_size=size.small,  bgcolor=regClr)
    table.cell(t, 1, 2, pulseStr,       text_color=color.white,  text_size=size.small,  bgcolor=pulse > 70 ? color.new(color.orange,25) : color.new(color.gray,50))

    // 3 — Alignment
    table.cell(t, 0, 3, "Согласование",text_color=color.silver, text_size=size.small,  bgcolor=color.new(color.black,40))
    table.cell(t, 1, 3, algStr,         text_color=color.white,  text_size=size.small,  bgcolor=algClr)

    // 4 — Conviction
    convStr = str.tostring(conviction) + " баров подряд"
    convClr = conviction > 5 ? color.new(color.green,20) : conviction > 2 ? color.new(color.teal,40) : color.new(color.gray,55)
    table.cell(t, 0, 4, "Conviction",  text_color=color.silver, text_size=size.small,  bgcolor=color.new(color.black,40))
    table.cell(t, 1, 4, convStr,        text_color=color.white,  text_size=size.small,  bgcolor=convClr)

    // 5—11 — 7 слоёв
    lNm = array.from("L1 Тренд","L2 Геометрия","L3 Давление","L4 Корреляции","L5 Макро","L6 Цикл","L7 Разворот")
    lVl = array.from(layer1, layer2, layer3, layer4, layer5, layer6, layer7)
    for i = 0 to 6
        lv   = array.get(lVl, i)
        ln   = array.get(lNm, i)
        lRnd = math.round(lv * 100)
        lSgn = lRnd >= 0 ? "+" : ""
        lDir = lv > 0.1 ? " ▲" : lv < -0.1 ? " ▼" : " ─"
        table.cell(t, 0, 5 + i, ln + lDir,              text_color=color.silver, text_size=size.small, bgcolor=color.new(color.black,40))
        table.cell(t, 1, 5 + i, lSgn + str.tostring(lRnd) + "  " + br(lv), text_color=color.white, text_size=size.small, bgcolor=sc(lv))

    // 12 — Разворотные сигналы
    table.cell(t, 0, 12, "Признаки",   text_color=color.silver, text_size=size.small, bgcolor=color.new(color.black,40))
    table.cell(t, 1, 12, revNow,        text_color=color.white,  text_size=size.small, bgcolor=sc(layer7))

    // 13 — Вход / SL / TP
    enS = na(lEntry) ? "—" : str.tostring(lEntry, format.mintick)
    slS = na(lSL)    ? "—" : str.tostring(lSL,    format.mintick)
    tpS = na(lTP)    ? "—" : str.tostring(lTP,    format.mintick)
    table.cell(t, 0, 13, "Вход / SL / TP", text_color=color.silver, text_size=size.small, bgcolor=color.new(color.black,40))
    table.cell(t, 1, 13, enS + " / " + slS + " / " + tpS, text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.black,25))

// ══════════════════════════════════════════════════════════════════════════════
//  АЛЕРТЫ
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(nexusBuy,                    "NEXUS LONG",       "⚡ NEXUS LONG {{ticker}} ({{interval}})")
alertcondition(nexusSell,                   "NEXUS SHORT",      "⚡ NEXUS SHORT {{ticker}} ({{interval}})")
alertcondition(ta.crossover(nScore,   40),  "NEXUS: Бычья зона","NEXUS: Вход в бычью зону {{ticker}}")
alertcondition(ta.crossunder(nScore, -40),  "NEXUS: Медвежья зона","NEXUS: Вход в медвежью зону {{ticker}}")
alertcondition(conviction == 1 and alignment >= nexusThr, "NEXUS: Начало серии", "NEXUS: Началась серия согласованных баров {{ticker}}")
