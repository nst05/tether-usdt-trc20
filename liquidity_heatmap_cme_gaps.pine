//@version=5
indicator("Liquidity Heatmap + CME Gaps", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 200)

// ═══════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════

// — Liquidity Heatmap —
grp_liq = "⚡ Liquidity Heatmap"
liq_enabled     = input.bool(true,  "Show Liquidity Zones",            group = grp_liq)
liq_lookback    = input.int(50,     "Swing Lookback (bars)",           group = grp_liq, minval = 5,   maxval = 500)
liq_swing_len   = input.int(5,      "Swing Pivot Length",              group = grp_liq, minval = 1,   maxval = 50)
liq_clusters    = input.int(8,      "Max Visible Zones",               group = grp_liq, minval = 2,   maxval = 30)
liq_zone_width  = input.float(0.3,  "Zone Width (%)",                  group = grp_liq, minval = 0.05, maxval = 2.0, step = 0.05)
liq_show_labels = input.bool(true,  "Show Labels",                     group = grp_liq)
liq_show_levels = input.bool(true,  "Show Level Lines",                group = grp_liq)

// — Colors —
grp_col = "🎨 Colors"
col_buyside   = input.color(color.new(color.teal,   55), "Buy-Side Liquidity  (above highs)", group = grp_col)
col_sellside  = input.color(color.new(color.red,    55), "Sell-Side Liquidity (below lows)",  group = grp_col)
col_strong    = input.color(color.new(color.yellow, 40), "Strong Zone Tint",                  group = grp_col)
col_buyside_l = input.color(color.new(color.teal,   0),  "Buy-Side Line",                     group = grp_col)
col_sellside_l= input.color(color.new(color.red,    0),  "Sell-Side Line",                    group = grp_col)

// — CME Gaps —
grp_cme = "📊 CME Gaps"
cme_enabled   = input.bool(true,  "Show CME Gaps",                group = grp_cme)
cme_filled_cl = input.bool(true,  "Show Filled Gaps",             group = grp_cme)
col_cme_bull  = input.color(color.new(color.lime,   75), "Bullish Gap (price jumped up)",  group = grp_cme)
col_cme_bear  = input.color(color.new(color.red,    75), "Bearish Gap (price dropped)",    group = grp_cme)
col_cme_fill  = input.color(color.new(color.gray,   85), "Filled Gap",                     group = grp_cme)
col_cme_bord_bull = input.color(color.new(color.lime, 20), "Bull Gap Border",              group = grp_cme)
col_cme_bord_bear = input.color(color.new(color.red,  20), "Bear Gap Border",              group = grp_cme)
cme_label_size = input.string("small", "Label Size", options = ["tiny","small","normal"], group = grp_cme)

// ═══════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════

label_sz(s) =>
    s == "tiny"   ? size.tiny :
     s == "small"  ? size.small : size.normal

// ═══════════════════════════════════════════════════════════════
//  SECTION 1 — LIQUIDITY HEATMAP
// ═══════════════════════════════════════════════════════════════
// Logic:
//   • Detect pivot highs  → buy-side liquidity pools (stops above)
//   • Detect pivot lows   → sell-side liquidity pools (stops below)
//   • Score each level by how many times price approached it
//     without breaking it (equal highs / lows = resting orders)
//   • Paint boxes whose opacity encodes relative strength

// --- Pivot detection ---
ph = ta.pivothigh(high, liq_swing_len, liq_swing_len)
pl = ta.pivotlow (low,  liq_swing_len, liq_swing_len)

// Collect swing highs / lows into arrays
var float[] hi_prices = array.new_float(0)
var int[]   hi_bars   = array.new_int(0)
var int[]   hi_hits   = array.new_int(0)   // touch count

var float[] lo_prices = array.new_float(0)
var int[]   lo_bars   = array.new_int(0)
var int[]   lo_hits   = array.new_int(0)

MERGE_DIST = liq_zone_width / 100          // fractional distance to merge similar levels

// helper – find index of an existing level within merge distance
find_near(arr, price) =>
    idx = -1
    for i = 0 to array.size(arr) - 1
        existing = array.get(arr, i)
        if math.abs(existing - price) / price <= MERGE_DIST
            idx := i
            break
    idx

// Register new pivots
if not na(ph)
    px = ph
    idx = find_near(hi_prices, px)
    if idx == -1
        array.push(hi_prices, px)
        array.push(hi_bars,   bar_index - liq_swing_len)
        array.push(hi_hits,   1)
    else
        array.set(hi_hits, idx, array.get(hi_hits, idx) + 1)

if not na(pl)
    px = pl
    idx = find_near(lo_prices, px)
    if idx == -1
        array.push(lo_prices, px)
        array.push(lo_bars,   bar_index - liq_swing_len)
        array.push(lo_hits,   1)
    else
        array.set(lo_hits, idx, array.get(lo_hits, idx) + 1)

// Purge levels older than lookback or already swept
purge_swept(prices, bars, hits, is_high) =>
    i = 0
    while i < array.size(prices)
        age   = bar_index - array.get(bars, i)
        price = array.get(prices, i)
        swept = is_high ? close > price : close < price
        if age > liq_lookback or swept
            array.remove(prices, i)
            array.remove(bars,   i)
            array.remove(hits,   i)
        else
            i += 1

purge_swept(hi_prices, hi_bars, hi_hits, true)
purge_swept(lo_prices, lo_bars, lo_hits, false)

// --- Draw zones on the last bar only to avoid redraw overhead ---
// We keep box/line references in arrays and recreate them each bar
var box[]   liq_boxes  = array.new_box(0)
var line[]  liq_lines  = array.new_line(0)
var label[] liq_labels = array.new_label(0)

clear_drawings() =>
    for b in liq_boxes
        box.delete(b)
    for l in liq_lines
        line.delete(l)
    for lb in liq_labels
        label.delete(lb)
    array.clear(liq_boxes)
    array.clear(liq_lines)
    array.clear(liq_labels)

// Score = number of touches; normalize to 0-1 for opacity
max_hits(hits_arr) =>
    mx = 1
    for i = 0 to array.size(hits_arr) - 1
        h = array.get(hits_arr, i)
        if h > mx
            mx := h
    mx

// Draw a single liquidity zone
draw_zone(price, hits, max_h, is_high) =>
    strength   = hits / max_h                          // 0.0 – 1.0
    opacity    = int(80 - strength * 55)               // 80% (weak) → 25% (strong)
    zone_half  = price * liq_zone_width / 100 / 2
    top_p      = is_high ? price + zone_half : price + zone_half
    bot_p      = is_high ? price - zone_half : price - zone_half
    base_col   = is_high ? col_buyside : col_sellside
    fill_col   = color.new(base_col, opacity)
    // tint strong zones
    if strength >= 0.8
        fill_col := color.new(col_strong, opacity + 10)

    x1 = bar_index - liq_swing_len - 2
    x2 = bar_index + 15

    if liq_enabled
        b = box.new(x1, top_p, x2, bot_p,
             border_color = color.new(base_col, 70),
             border_width  = 1,
             bgcolor       = fill_col)
        array.push(liq_boxes, b)

        if liq_show_levels
            lc = is_high ? col_buyside_l : col_sellside_l
            l  = line.new(x1, price, x2, price,
                 color = color.new(lc, 30),
                 width = 1,
                 style = line.style_dashed)
            array.push(liq_lines, l)

        if liq_show_labels
            lbl_txt = (is_high ? "BSL " : "SSL ") +
                      str.tostring(price, format.mintick) +
                      " ×" + str.tostring(hits)
            lbl_col = is_high ? col_buyside_l : col_sellside_l
            lb = label.new(x2, price,
                 text  = lbl_txt,
                 color = color.new(lbl_col, 20),
                 textcolor = color.white,
                 style = label.style_label_left,
                 size  = size.tiny)
            array.push(liq_labels, lb)

// Rebuild visuals on every bar (efficient via array clear)
if barstate.islast
    clear_drawings()
    max_h_hi = max_hits(hi_hits)
    max_h_lo = max_hits(lo_hits)

    // Sort by hits descending, show top N
    n_hi = math.min(array.size(hi_prices), liq_clusters)
    n_lo = math.min(array.size(lo_prices), liq_clusters)

    // Draw highs (buy-side)
    for i = 0 to n_hi - 1
        draw_zone(array.get(hi_prices, i), array.get(hi_hits, i), max_h_hi, true)

    // Draw lows (sell-side)
    for i = 0 to n_lo - 1
        draw_zone(array.get(lo_prices, i), array.get(lo_hits, i), max_h_lo, false)

// ═══════════════════════════════════════════════════════════════
//  SECTION 2 — CME GAPS
// ═══════════════════════════════════════════════════════════════
// CME Bitcoin futures:  Mon–Fri  18:00–17:00 CT  (Sun 18:00 open)
// Gap = Friday 17:00 close  →  Sunday 18:00 open
// We detect them on a DAILY chart by checking:
//   • Previous bar was Friday (dayofweek == 6)  and
//   • Current bar is Monday  (dayofweek == 2)   (daily bar skips weekend)
// On intraday charts: detect the jump in the Sunday candle open vs prev close.

// Persistent gap storage
var float[] cme_top    = array.new_float(0)
var float[] cme_bot    = array.new_float(0)
var bool[]  cme_bull   = array.new_bool(0)    // true = bullish gap (open > prev close)
var bool[]  cme_filled = array.new_bool(0)
var int[]   cme_start  = array.new_int(0)

// Gap detection works on ANY timeframe; we compare daily session boundaries
// using the built-in `request.security` daily close.
prev_d_close = request.security(syminfo.tickerid, "1D", close[1], lookahead = barmerge.lookahead_on)
curr_d_open  = request.security(syminfo.tickerid, "1D", open,     lookahead = barmerge.lookahead_on)

// Detect Monday daily bar (gap formed over the weekend)
is_monday_daily = (timeframe.isdaily and dayofweek == dayofweek.monday)
// Intraday: detect the first bar of Monday session where open gaps from prev close
is_monday_intra = (not timeframe.isdaily and
                   dayofweek == dayofweek.monday and
                   hour(time, "America/Chicago") == 18 and
                   minute(time, "America/Chicago") < 15)

gap_detected  = is_monday_daily or is_monday_intra
gap_top_price = math.max(curr_d_open, prev_d_close)
gap_bot_price = math.min(curr_d_open, prev_d_close)
gap_size_pct  = math.abs(curr_d_open - prev_d_close) / prev_d_close * 100
is_bull_gap   = curr_d_open > prev_d_close

MIN_GAP_PCT = 0.05   // ignore gaps smaller than 0.05%

if cme_enabled and gap_detected and gap_size_pct >= MIN_GAP_PCT
    array.push(cme_top,    gap_top_price)
    array.push(cme_bot,    gap_bot_price)
    array.push(cme_bull,   is_bull_gap)
    array.push(cme_filled, false)
    array.push(cme_start,  bar_index)

// Mark gap as filled when price crosses through it
if cme_enabled
    for i = 0 to array.size(cme_top) - 1
        if not array.get(cme_filled, i)
            t = array.get(cme_top, i)
            b = array.get(cme_bot, i)
            // Filled when the candle body crosses the midpoint
            mid = (t + b) / 2
            if (low <= mid and high >= mid)
                array.set(cme_filled, i, true)

// Draw CME gap boxes (rebuild on last bar)
var box[]   cme_boxes  = array.new_box(0)
var label[] cme_labels = array.new_label(0)

clear_cme() =>
    for b in cme_boxes
        box.delete(b)
    for lb in cme_labels
        label.delete(lb)
    array.clear(cme_boxes)
    array.clear(cme_labels)

if barstate.islast
    clear_cme()
    for i = 0 to array.size(cme_top) - 1
        filled = array.get(cme_filled, i)
        if not filled or cme_filled_cl
            t      = array.get(cme_top,  i)
            b      = array.get(cme_bot,  i)
            bull   = array.get(cme_bull, i)
            x1     = array.get(cme_start, i)
            x2     = bar_index + 5
            sz_pct = math.abs(t - b) / b * 100

            bg_col  = filled ? col_cme_fill  : (bull ? col_cme_bull  : col_cme_bear)
            brd_col = filled ? color.new(color.gray, 60) : (bull ? col_cme_bord_bull : col_cme_bord_bear)

            bx = box.new(x1, t, x2, b,
                 bgcolor      = bg_col,
                 border_color = brd_col,
                 border_width = 1)
            array.push(cme_boxes, bx)

            lbl_text = (bull ? "▲ CME GAP" : "▼ CME GAP") +
                       "\nTop: "  + str.tostring(t, format.mintick) +
                       "\nBot: "  + str.tostring(b, format.mintick) +
                       "\n"       + str.tostring(sz_pct, "#.##") + "%" +
                       (filled ? "\n✓ Filled" : "")
            lbl_col  = filled ? color.gray : (bull ? color.lime : color.red)
            lb = label.new((x1 + x2) / 2, (t + b) / 2,
                 text      = lbl_text,
                 color     = color.new(lbl_col, 30),
                 textcolor = color.white,
                 style     = label.style_label_center,
                 size      = label_sz(cme_label_size))
            array.push(cme_labels, lb)

// ═══════════════════════════════════════════════════════════════
//  SECTION 3 — DASHBOARD (table)
// ═══════════════════════════════════════════════════════════════
grp_dash = "📋 Dashboard"
show_dash = input.bool(true, "Show Dashboard", group = grp_dash)
dash_pos  = input.string("Bottom Right", "Position",
             options = ["Top Right","Top Left","Bottom Right","Bottom Left"],
             group = grp_dash)

tbl_pos(s) =>
    s == "Top Right"    ? position.top_right    :
     s == "Top Left"     ? position.top_left     :
     s == "Bottom Right" ? position.bottom_right : position.bottom_left

var table dash = table.new(tbl_pos(dash_pos), 2, 7,
     bgcolor      = color.new(color.black, 70),
     border_color = color.new(color.white, 60),
     border_width = 1)

if barstate.islast and show_dash
    // Header
    table.cell(dash, 0, 0, "LIQUIDITY HEATMAP + CME", text_color = color.white,
         bgcolor = color.new(color.navy, 30), text_size = size.small, colspan = 2)

    // Liquidity summary
    table.cell(dash, 0, 1, "BSL Zones",  text_color = color.teal,  text_size = size.tiny)
    table.cell(dash, 1, 1, str.tostring(array.size(hi_prices)), text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 2, "SSL Zones",  text_color = color.red,   text_size = size.tiny)
    table.cell(dash, 1, 2, str.tostring(array.size(lo_prices)), text_color = color.white, text_size = size.tiny)

    // Nearest BSL / SSL
    nearest_bsl = array.size(hi_prices) > 0 ? array.min(hi_prices) : na
    nearest_ssl = array.size(lo_prices) > 0 ? array.max(lo_prices) : na

    table.cell(dash, 0, 3, "Nearest BSL", text_color = color.teal, text_size = size.tiny)
    table.cell(dash, 1, 3, na(nearest_bsl) ? "—" : str.tostring(nearest_bsl, format.mintick),
         text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 4, "Nearest SSL", text_color = color.red, text_size = size.tiny)
    table.cell(dash, 1, 4, na(nearest_ssl) ? "—" : str.tostring(nearest_ssl, format.mintick),
         text_color = color.white, text_size = size.tiny)

    // CME summary
    open_gaps   = 0
    filled_gaps = 0
    for i = 0 to array.size(cme_filled) - 1
        if array.get(cme_filled, i)
            filled_gaps += 1
        else
            open_gaps += 1

    table.cell(dash, 0, 5, "CME Open",   text_color = color.yellow, text_size = size.tiny)
    table.cell(dash, 1, 5, str.tostring(open_gaps),   text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 6, "CME Filled", text_color = color.gray,   text_size = size.tiny)
    table.cell(dash, 1, 6, str.tostring(filled_gaps), text_color = color.white, text_size = size.tiny)
