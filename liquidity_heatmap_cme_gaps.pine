//@version=6
indicator("Liquidity Heatmap + CME Gaps", overlay = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 200)

// ══════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════
g1 = "⚡ Liquidity"
liq_on   = input.bool(true,  "Show Liquidity Zones",  group = g1)
liq_len  = input.int(5,      "Pivot Length",           group = g1, minval = 1, maxval = 30)
liq_ext  = input.int(60,     "Line Extend (bars)",     group = g1, minval = 10, maxval = 500)
liq_lbl  = input.bool(true,  "Show Labels",            group = g1)
liq_zone = input.bool(true,  "Show Zone Box",          group = g1)
liq_w    = input.float(0.25, "Zone Width (%)",         group = g1, minval = 0.05, maxval = 2.0, step = 0.05)

g2 = "🎨 Colors"
c_bsl   = input.color(color.new(color.teal,  0),  "BSL line",  group = g2)
c_ssl   = input.color(color.new(color.red,   0),  "SSL line",  group = g2)
c_bsl_z = input.color(color.new(color.teal,  70), "BSL zone",  group = g2)
c_ssl_z = input.color(color.new(color.red,   70), "SSL zone",  group = g2)

g3 = "📊 CME Gaps"
cme_on  = input.bool(true,  "Show CME Gaps",    group = g3)
cme_ext = input.int(300,    "Gap Extend (bars)", group = g3, minval = 10, maxval = 1000)
cme_min = input.float(0.05, "Min Gap (%)",       group = g3, minval = 0.01, step = 0.01)
c_bull  = input.color(color.new(color.lime, 72), "Bullish Gap", group = g3)
c_bear  = input.color(color.new(color.red,  72), "Bearish Gap", group = g3)

// ══════════════════════════════════════════════════════════════
//  SECTION 1 — LIQUIDITY (pivot highs = BSL, pivot lows = SSL)
//  Draw directly on detection — no barstate.islast needed
// ══════════════════════════════════════════════════════════════

ph = ta.pivothigh(liq_len, liq_len)
pl = ta.pivotlow (liq_len, liq_len)

// The pivot bar is liq_len bars in the past
int pivot_bar = bar_index - liq_len

if not na(ph) and liq_on
    float half = ph * liq_w / 100.0 / 2.0
    int   x2   = pivot_bar + liq_ext

    // Dashed level line
    line.new(pivot_bar, ph, x2, ph,
         color = c_bsl,
         width = 1,
         style = line.style_dashed)

    // Zone box
    if liq_zone
        box.new(pivot_bar, ph + half, x2, ph - half,
             bgcolor      = c_bsl_z,
             border_color = color.new(c_bsl, 60),
             border_width = 1)

    // Label
    if liq_lbl
        label.new(x2, ph,
             text      = "BSL " + str.tostring(ph, format.mintick),
             color     = color.new(c_bsl, 20),
             textcolor = color.white,
             style     = label.style_label_left,
             size      = size.tiny)

if not na(pl) and liq_on
    float half = pl * liq_w / 100.0 / 2.0
    int   x2   = pivot_bar + liq_ext

    line.new(pivot_bar, pl, x2, pl,
         color = c_ssl,
         width = 1,
         style = line.style_dashed)

    if liq_zone
        box.new(pivot_bar, pl + half, x2, pl - half,
             bgcolor      = c_ssl_z,
             border_color = color.new(c_ssl, 60),
             border_width = 1)

    if liq_lbl
        label.new(x2, pl,
             text      = "SSL " + str.tostring(pl, format.mintick),
             color     = color.new(c_ssl, 20),
             textcolor = color.white,
             style     = label.style_label_left,
             size      = size.tiny)

// ══════════════════════════════════════════════════════════════
//  SECTION 2 — CME GAPS
//  Monday daily open vs Friday daily close
// ══════════════════════════════════════════════════════════════

float d_open = request.security(syminfo.tickerid, "1D", open,       lookahead = barmerge.lookahead_on)
float d_prev = request.security(syminfo.tickerid, "1D", close[1],   lookahead = barmerge.lookahead_on)
int   d_dow  = request.security(syminfo.tickerid, "1D", dayofweek,  lookahead = barmerge.lookahead_on)

bool is_monday  = d_dow == dayofweek.monday
bool day_opened = ta.change(d_open) != 0

if cme_on and is_monday and day_opened and not na(d_prev) and d_prev != 0.0
    float g_hi  = math.max(d_open, d_prev)
    float g_lo  = math.min(d_open, d_prev)
    float g_pct = math.abs(d_open - d_prev) / d_prev * 100.0

    if g_pct >= cme_min
        bool  bull   = d_open > d_prev
        color bg_col = bull ? c_bull : c_bear
        color br_col = bull ? color.new(color.lime, 20) : color.new(color.red, 20)
        int   x2     = bar_index + cme_ext

        box.new(bar_index, g_hi, x2, g_lo,
             bgcolor      = bg_col,
             border_color = br_col,
             border_width = 1)

        string dir  = bull ? "^ CME GAP" : "v CME GAP"
        string info = dir +
             "\nTop: " + str.tostring(g_hi, format.mintick) +
             "\nBot: " + str.tostring(g_lo, format.mintick) +
             "\n"      + str.tostring(g_pct, "#.##") + "%"

        label.new(bar_index, g_hi,
             text      = info,
             color     = color.new(bull ? color.lime : color.red, 25),
             textcolor = color.white,
             style     = label.style_label_lower_right,
             size      = size.small)

// ══════════════════════════════════════════════════════════════
//  SECTION 3 — INFO TABLE
// ══════════════════════════════════════════════════════════════

g4 = "📋 Dashboard"
dash_on  = input.bool(true, "Show Table", group = g4)
dash_pos = input.string("Bottom Right", "Position",
             options = ["Top Right","Top Left","Bottom Right","Bottom Left"],
             group = g4)

var string tpos = dash_pos == "Top Right"   ? position.top_right  :
                  dash_pos == "Top Left"    ? position.top_left   :
                  dash_pos == "Bottom Left" ? position.bottom_left : position.bottom_right

var table tb = table.new(tpos, 2, 4,
     bgcolor      = color.new(color.black, 60),
     border_color = color.new(color.white, 50),
     border_width = 1)

if barstate.islast and dash_on
    table.cell(tb, 0, 0, "LIQ + CME GAPS",
         text_color = color.white,
         bgcolor    = color.new(color.navy, 20),
         text_size  = size.small,
         colspan    = 2)
    table.cell(tb, 0, 1, "BSL = buy-side stops", text_color = color.teal, text_size = size.tiny)
    table.cell(tb, 1, 1, "above highs",          text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 2, "SSL = sell-side stops", text_color = color.red,  text_size = size.tiny)
    table.cell(tb, 1, 2, "below lows",            text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 3, "CME gap",               text_color = color.yellow, text_size = size.tiny)
    table.cell(tb, 1, 3, "Mon open vs Fri close", text_color = color.white, text_size = size.tiny)
