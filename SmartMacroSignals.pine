//@version=6
indicator("Smart Macro Signals PRO", "SMS PRO", overlay=false, max_labels_count=30, max_lines_count=10)

// ── НАСТРОЙКИ ────────────────────────────────────────────────────────────────
wTrend  = input.float(1.0, "Вес Тренд",        minval=0, maxval=3, step=0.1, group="Веса")
wCorr   = input.float(1.0, "Вес Корреляция",   minval=0, maxval=3, step=0.1, group="Веса")
wMacro  = input.float(0.5, "Вес Макро",        minval=0, maxval=3, step=0.1, group="Веса")
wSMC    = input.float(1.0, "Вес Smart Money",  minval=0, maxval=3, step=0.1, group="Веса")

buyThr  = input.float( 25, "Порог BUY (≥)",       minval=5,   maxval=90, step=1, group="Сигналы")
sellThr = input.float(-25, "Порог SELL (≤)",      minval=-90, maxval=-5, step=1, group="Сигналы")
confMin = input.float( 30, "Мин. уверенность %",  minval=0,   maxval=100, step=5, group="Сигналы")
maxLbls = input.int(3, "Макс. меток BUY/SELL",    minval=1,   maxval=10, group="Сигналы")

emaFast  = input.int(50,   "EMA быстрая",   minval=2,   group="Тренд")
emaSlow  = input.int(200,  "EMA медленная", minval=10,  group="Тренд")
rsiLen   = input.int(14,   "RSI период",    minval=2,   group="Тренд")
corrLen  = input.int(50,   "Окно корреляции", minval=10, group="Корреляция")

sym1     = input.symbol("TVC:DXY",         "DXY",  group="Корреляция")
sym2     = input.symbol("SP:SPX",          "SPX",  group="Корреляция")
sym3     = input.symbol("TVC:GOLD",        "Gold", group="Корреляция")
sym4     = input.symbol("BINANCE:BTCUSDT", "BTC",  group="Корреляция")
symYield = input.symbol("TVC:US10Y",       "US10Y", group="Макро")
symVix   = input.symbol("CBOE:VIX",        "VIX",   group="Макро")

swingLen = input.int(10,   "Pivot-свинг",   minval=2,   group="Smart Money")
atrLen   = input.int(14,   "ATR период",    minval=2,   group="Риск")
slMul    = input.float(1.5,"SL = ATR ×",   minval=0.2, step=0.1, group="Риск")
rr1      = input.float(1.5,"TP1 R:R",      minval=0.5, step=0.1, group="Риск")
rr2      = input.float(3.0,"TP2 R:R",      minval=0.5, step=0.1, group="Риск")
moveEff  = input.float(0.5,"Скорость хода",minval=0.1, maxval=1.0, step=0.05, group="Риск")

tf1 = input.timeframe("15",  "TF1", group="Таймфреймы")
tf2 = input.timeframe("60",  "TF2", group="Таймфреймы")
tf3 = input.timeframe("240", "TF3", group="Таймфреймы")
tf4 = input.timeframe("D",   "TF4", group="Таймфреймы")

// ── ФУНКЦИИ ──────────────────────────────────────────────────────────────────
clamp1(x) => math.max(-1.0, math.min(1.0, x))
soft(x, s) => clamp1(s == 0 ? math.sign(x) : x / s)
nz0(x)    => na(x) ? 0.0 : x

// ── ТРЕНД ────────────────────────────────────────────────────────────────────
_atr = ta.atr(atrLen)
_ef  = ta.ema(close, emaFast)
_es  = ta.ema(close, emaSlow)
_rsi = ta.rsi(close, rsiLen)
[_ml, _sl, _hist] = ta.macd(close, 12, 26, 9)
_roc = ta.roc(close, 20)

trendScore = clamp1(((close > _ef ? 0.5 : -0.5) + (_ef > _es ? 0.5 : -0.5) + soft(_ef - _ef[3], _atr) + clamp1((_rsi - 50) / 25) + soft(_hist, _atr * 0.5) + soft(_roc, 5.0)) / 6.0)

// ── КОРРЕЛЯЦИЯ ───────────────────────────────────────────────────────────────
a1c = request.security(sym1, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a1e = request.security(sym1, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a2c = request.security(sym2, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a2e = request.security(sym2, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a3c = request.security(sym3, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a3e = request.security(sym3, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a4c = request.security(sym4, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
a4e = request.security(sym4, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

contrib(ac, ae) => na(ac) or na(ae) ? 0.0 : clamp1(nz0(ta.correlation(close, ac, corrLen)) * (ac > ae ? 1.0 : -1.0))
corrScore = clamp1((contrib(a1c,a1e) + contrib(a2c,a2e) + contrib(a3c,a3e) + contrib(a4c,a4e)) / 4.0)

// ── МАКРО ────────────────────────────────────────────────────────────────────
yNow = request.security(symYield, "D", close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
yMa  = request.security(symYield, "D", ta.sma(close,20), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vNow = request.security(symVix,   "D", close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vMa  = request.security(symVix,   "D", ta.sma(close,20), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

macroScore = clamp1(((na(yNow) or na(yMa) ? 0.0 : -soft(yNow - yMa, math.max(yMa*0.05, 0.01))) + (na(vNow) or na(vMa) ? 0.0 : -soft(vNow - vMa, math.max(vMa*0.15, 1.0)))) / 2.0)

// ── SMART MONEY ──────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)
var float swH = na
var float swL = na
if not na(ph)
    swH := ph
if not na(pl)
    swL := pl
var int structBias = 0
if not na(swH) and close > swH
    structBias := 1
if not na(swL) and close < swL
    structBias := -1
bullSweep = not na(swL) and low  < swL and close > swL
bearSweep = not na(swH) and high > swH and close < swH
smcScore  = clamp1(structBias * 0.7 + (bullSweep ? 1.0 : bearSweep ? -1.0 : 0.0) * 0.3)

// ── ИТОГ ─────────────────────────────────────────────────────────────────────
wSum  = math.max(wTrend + wCorr + wMacro + wSMC, 0.0001)
raw   = (trendScore*wTrend + corrScore*wCorr + macroScore*wMacro + smcScore*wSMC) / wSum
score = nz0(raw) * 100.0

ag = (math.sign(trendScore)==math.sign(raw) and trendScore!=0 ? 1:0) + (math.sign(corrScore)==math.sign(raw) and corrScore!=0 ? 1:0) + (math.sign(macroScore)==math.sign(raw) and macroScore!=0 ? 1:0) + (math.sign(smcScore)==math.sign(raw) and smcScore!=0 ? 1:0)
confidence = math.round(math.min(100, math.abs(score)*0.6 + ag*10))

// ── СИГНАЛЫ ──────────────────────────────────────────────────────────────────
var int state = 0
buy  = ta.crossover(score,  buyThr)  and confidence >= confMin and state <= 0
sell = ta.crossunder(score, sellThr) and confidence >= confMin and state >= 0
if buy
    state := 1
if sell
    state := -1

// ── ГИСТОГРАММА ──────────────────────────────────────────────────────────────
hline(buyThr,  color=color.new(color.green, 50), linestyle=hline.style_dashed)
hline(sellThr, color=color.new(color.red,   50), linestyle=hline.style_dashed)
hline(0,       color=color.new(color.gray,  60))

sCol = score > 0 ? color.new(color.teal, 20) : color.new(color.red, 20)
plot(score, "Счёт", color=sCol, style=plot.style_histogram, linewidth=4)
plot(score, "",     color=color.new(sCol, 0), linewidth=2)

plotshape(buy,  "", shape.triangleup,   location.bottom, color.lime, size=size.large)
plotshape(sell, "", shape.triangledown, location.top,    color.red,  size=size.large)

// ── МЕТКИ СИГНАЛОВ (последние N) ─────────────────────────────────────────────
var label[] lblQ = array.new_label()

if buy or sell
    isBuy = buy
    sl    = isBuy ? close - _atr*slMul   : close + _atr*slMul
    risk  = math.abs(close - sl)
    tp1   = isBuy ? close + risk*rr1     : close - risk*rr1
    tp2   = isBuy ? close + risk*rr2     : close - risk*rr2
    bars  = _atr*moveEff > 0 ? math.round(risk*rr1 / (_atr*moveEff)) : 0
    sec   = bars * timeframe.in_seconds(timeframe.period)
    hrs   = sec / 3600.0
    tstr  = hrs < 1 ? str.tostring(math.round(sec/60)) + "мин" : hrs < 48 ? str.tostring(math.round(hrs,1)) + "ч" : str.tostring(math.round(hrs/24,1)) + "дн"

    line1 = (isBuy ? "▲ ПОКУПАТЬ" : "▼ ПРОДАВАТЬ") + "   " + str.tostring(math.round(score)) + " pts"
    line2 = "Вход:  " + str.tostring(close, format.mintick)
    line3 = "SL:      " + str.tostring(sl, format.mintick)
    line4 = "TP1:    " + str.tostring(tp1, format.mintick)
    line5 = "TP2:    " + str.tostring(tp2, format.mintick)
    line6 = "Время: ~" + tstr + "   Увер: " + str.tostring(confidence) + "%"

    lbl = label.new(bar_index, isBuy ? buyThr + 10 : sellThr - 10,
         line1 + "\n" + line2 + "\n" + line3 + "\n" + line4 + "\n" + line5 + "\n" + line6,
         style     = isBuy ? label.style_label_upper_left : label.style_label_lower_left,
         color     = isBuy ? color.new(color.green, 0) : color.new(color.red, 0),
         textcolor = color.white,
         size      = size.large)
    array.push(lblQ, lbl)
    if array.size(lblQ) > maxLbls
        label.delete(array.shift(lblQ))

// ── ПАНЕЛЬ СЛЕВА ВВЕРХУ (счёт по модулям) ────────────────────────────────────
sc(s) => s > 0 ? color.new(color.teal, 30) : s < 0 ? color.new(color.red, 30) : color.new(color.gray, 50)
st(s) => (s > 0 ? "+" : "") + str.tostring(math.round(s * 100))

if barstate.islast
    var table inf = table.new(position.top_left, 3, 6, border_width=1, frame_color=color.new(color.gray,30), frame_width=1, bgcolor=color.new(color.black, 40))

    biasStr = score >= buyThr ? "ЛОНГ ▲" : score <= sellThr ? "ШОРТ ▼" : "НЕЙТРАЛ"
    biasClr = score >= buyThr ? color.new(color.green, 10) : score <= sellThr ? color.new(color.red, 10) : color.new(color.gray, 40)
    scoreStr = str.tostring(math.round(score))
    confStr  = str.tostring(confidence) + "%"

    table.cell(inf, 0, 0, "СИГНАЛ",  text_color=color.new(color.gray,20),  text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(inf, 1, 0, biasStr,   text_color=color.white, text_size=size.normal, bgcolor=biasClr)
    table.cell(inf, 2, 0, confStr,   text_color=color.white, text_size=size.normal, bgcolor=color.new(color.purple,20))

    table.cell(inf, 0, 1, "СЧЁТ",    text_color=color.new(color.gray,20), text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(inf, 1, 1, scoreStr,  text_color=color.white, text_size=size.normal, bgcolor=sc(score))
    table.cell(inf, 2, 1, "/ 100",   text_color=color.new(color.gray,30), text_size=size.small, bgcolor=color.new(color.black,50))

    table.cell(inf, 0, 2, "Тренд",   text_color=color.new(color.gray,20), text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(inf, 1, 2, st(trendScore), text_color=color.white, text_size=size.normal, bgcolor=sc(trendScore))
    table.cell(inf, 2, 2, "",        bgcolor=color.new(color.black,50))

    table.cell(inf, 0, 3, "Коррел.", text_color=color.new(color.gray,20), text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(inf, 1, 3, st(corrScore),  text_color=color.white, text_size=size.normal, bgcolor=sc(corrScore))
    table.cell(inf, 2, 3, "",        bgcolor=color.new(color.black,50))

    table.cell(inf, 0, 4, "Макро",   text_color=color.new(color.gray,20), text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(inf, 1, 4, st(macroScore), text_color=color.white, text_size=size.normal, bgcolor=sc(macroScore))
    table.cell(inf, 2, 4, "",        bgcolor=color.new(color.black,50))

    table.cell(inf, 0, 5, "SMC",     text_color=color.new(color.gray,20), text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(inf, 1, 5, st(smcScore),   text_color=color.white, text_size=size.normal, bgcolor=sc(smcScore))
    table.cell(inf, 2, 5, "",        bgcolor=color.new(color.black,50))

// ── ТАЙМФРЕЙМЫ СПРАВА ВВЕРХУ ─────────────────────────────────────────────────
simpleBias() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    r  = ta.rsi(close, rsiLen)
    clamp1((close>ef?0.34:-0.34) + (ef>es?0.33:-0.33) + clamp1((r-50)/25)*0.33) * 100.0

b1 = request.security(syminfo.tickerid, tf1, simpleBias(), lookahead=barmerge.lookahead_off)
b2 = request.security(syminfo.tickerid, tf2, simpleBias(), lookahead=barmerge.lookahead_off)
b3 = request.security(syminfo.tickerid, tf3, simpleBias(), lookahead=barmerge.lookahead_off)
b4 = request.security(syminfo.tickerid, tf4, simpleBias(), lookahead=barmerge.lookahead_off)

mt(b) => nz0(b) >  20 ? "BUY ▲" : nz0(b) < -20 ? "SELL▼" : " — "
mc(b) => nz0(b) >  20 ? color.new(color.teal, 20) : nz0(b) < -20 ? color.new(color.red, 20) : color.new(color.gray, 50)

if barstate.islast
    var table mtf = table.new(position.top_right, 2, 5, border_width=1, frame_color=color.new(color.gray,30), frame_width=1, bgcolor=color.new(color.black,40))
    table.cell(mtf, 0, 0, "ТФ",    text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy,20))
    table.cell(mtf, 1, 0, "Сигнал",text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy,20))
    table.cell(mtf, 0, 1, tf1, text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black,50))
    table.cell(mtf, 1, 1, mt(b1), text_color=color.white, text_size=size.normal, bgcolor=mc(b1))
    table.cell(mtf, 0, 2, tf2, text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black,50))
    table.cell(mtf, 1, 2, mt(b2), text_color=color.white, text_size=size.normal, bgcolor=mc(b2))
    table.cell(mtf, 0, 3, tf3, text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black,50))
    table.cell(mtf, 1, 3, mt(b3), text_color=color.white, text_size=size.normal, bgcolor=mc(b3))
    table.cell(mtf, 0, 4, tf4, text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black,50))
    table.cell(mtf, 1, 4, mt(b4), text_color=color.white, text_size=size.normal, bgcolor=mc(b4))

// ── АЛЕРТЫ ───────────────────────────────────────────────────────────────────
alertcondition(buy,  "BUY",  "SMS PRO: BUY {{ticker}} ({{interval}})")
alertcondition(sell, "SELL", "SMS PRO: SELL {{ticker}} ({{interval}})")
