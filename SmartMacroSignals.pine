//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Smart Macro Signals PRO  |  Pine Script v6
//  Бычий/медвежий счёт -100…+100 из 4 модулей.
//  Гарантированный вывод: plot(score) в нижней панели + barcolor + стрелки.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Smart Macro Signals PRO", "SMS PRO", overlay=false,
          max_labels_count=200, max_lines_count=200)

// ══════════════════════════════════════════════════════════════════════════════
//  НАСТРОЙКИ
// ══════════════════════════════════════════════════════════════════════════════
// Веса
wTrend = input.float(1.0, "Вес Тренд",        minval=0, maxval=3, step=0.1, group="Веса")
wCorr  = input.float(1.0, "Вес Корреляция",   minval=0, maxval=3, step=0.1, group="Веса")
wMacro = input.float(0.5, "Вес Макро",        minval=0, maxval=3, step=0.1, group="Веса")
wSMC   = input.float(1.0, "Вес Smart Money",  minval=0, maxval=3, step=0.1, group="Веса")

// Пороги
buyThr  = input.float( 25, "Порог BUY  (≥)", minval=5,  maxval=90, step=1, group="Сигналы")
sellThr = input.float(-25, "Порог SELL (≤)", minval=-90, maxval=-5, step=1, group="Сигналы")
confMin = input.float( 30, "Мин. уверенность %", minval=0, maxval=100, step=5, group="Сигналы")

// Тренд
emaFast = input.int(50,  "EMA быстрая",   minval=2,  group="Тренд")
emaSlow = input.int(200, "EMA медленная", minval=10, group="Тренд")
rsiLen  = input.int(14,  "RSI период",    minval=2,  group="Тренд")

// Корреляция
corrLen = input.int(50, "Окно корреляции", minval=10, group="Корреляция")
sym1 = input.symbol("TVC:DXY",         "Актив 1 (DXY)",   group="Корреляция")
sym2 = input.symbol("SP:SPX",          "Актив 2 (SPX)",   group="Корреляция")
sym3 = input.symbol("TVC:GOLD",        "Актив 3 (Gold)",  group="Корреляция")
sym4 = input.symbol("BINANCE:BTCUSDT", "Актив 4 (BTC)",   group="Корреляция")

// Макро
symYield = input.symbol("TVC:US10Y", "US10Y (доходность)", group="Макро")
symVix   = input.symbol("CBOE:VIX",  "VIX (волатильность)", group="Макро")

// SMC
swingLen = input.int(10, "Pivot-свинг (баров)", minval=2, group="Smart Money")

// Риск
atrLen   = input.int(14,   "ATR период",       minval=2,   group="Риск")
slMul    = input.float(1.5,"SL = ATR ×",       minval=0.2, step=0.1, group="Риск")
rr1      = input.float(1.5,"TP1  R:R",         minval=0.5, step=0.1, group="Риск")
rr2      = input.float(3.0,"TP2  R:R",         minval=0.5, step=0.1, group="Риск")
moveEff  = input.float(0.5,"Эффективность хода",minval=0.1,maxval=1.0,step=0.05,group="Риск")

// Отображение
showTbl  = input.bool(true,  "Панель с цифрами",        group="Вид")
showMTF  = input.bool(true,  "Таблица таймфреймов",      group="Вид")
tf1 = input.timeframe("15",  "TF1", group="Вид")
tf2 = input.timeframe("60",  "TF2", group="Вид")
tf3 = input.timeframe("240", "TF3", group="Вид")
tf4 = input.timeframe("D",   "TF4", group="Вид")

// ══════════════════════════════════════════════════════════════════════════════
//  ВСПОМ. ФУНКЦИИ
// ══════════════════════════════════════════════════════════════════════════════
clamp1(x)          => math.max(-1.0, math.min(1.0, x))
soft(x, s)         => clamp1(s == 0 ? math.sign(x) : x / s)
nz0(x)             => na(x) ? 0.0 : x

// ══════════════════════════════════════════════════════════════════════════════
//  МОДУЛЬ 1 — ТРЕНД
// ══════════════════════════════════════════════════════════════════════════════
_atr   = ta.atr(atrLen)
_ef    = ta.ema(close, emaFast)
_es    = ta.ema(close, emaSlow)
_rsi   = ta.rsi(close, rsiLen)
[_ml, _sl, _hist] = ta.macd(close, 12, 26, 9)
_roc   = ta.roc(close, 20)

emaAlign   = (close > _ef ? 0.5 : -0.5) + (_ef > _es ? 0.5 : -0.5)
emaSlope   = soft(_ef - _ef[3], _atr)
rsiS       = clamp1((_rsi - 50) / 25)
macdS      = soft(_hist, _atr * 0.5)
rocS       = soft(_roc, 5.0)
trendScore = clamp1((emaAlign + emaSlope + rsiS + macdS + rocS) / 5.0)

// ══════════════════════════════════════════════════════════════════════════════
//  МОДУЛЬ 2 — КОРРЕЛЯЦИЯ
//  Для каждого актива: corr(close_нашего, close_актива) × знак(тренд_актива)
// ══════════════════════════════════════════════════════════════════════════════
_get(sym) =>
    [request.security(sym, timeframe.period, close,            lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true),
     request.security(sym, timeframe.period, ta.ema(close,50), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)]

[a1, a1e] = _get(sym1)
[a2, a2e] = _get(sym2)
[a3, a3e] = _get(sym3)
[a4, a4e] = _get(sym4)

contrib(aClose, aEma) =>
    na(aClose) or na(aEma) ? 0.0 :
     clamp1(nz0(ta.correlation(close, aClose, corrLen)) * (aClose > aEma ? 1.0 : -1.0))

c1 = contrib(a1, a1e)
c2 = contrib(a2, a2e)
c3 = contrib(a3, a3e)
c4 = contrib(a4, a4e)
corrScore = clamp1((c1 + c2 + c3 + c4) / 4.0)

// ══════════════════════════════════════════════════════════════════════════════
//  МОДУЛЬ 3 — МАКРО (реальные тикеры TradingView, risk-on/off)
//  Рост US10Y / VIX = risk-off → отрицательный вклад
// ══════════════════════════════════════════════════════════════════════════════
yNow  = request.security(symYield, "D", close,             lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
yMa   = request.security(symYield, "D", ta.sma(close, 20), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vNow  = request.security(symVix,   "D", close,             lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vMa   = request.security(symVix,   "D", ta.sma(close, 20), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

yS = (na(yNow) or na(yMa)) ? 0.0 : -soft(yNow - yMa, math.max(yMa * 0.05, 0.01))
vS = (na(vNow) or na(vMa)) ? 0.0 : -soft(vNow - vMa, math.max(vMa * 0.15, 1.0))
macroScore = clamp1((yS + vS) / 2.0)

// ══════════════════════════════════════════════════════════════════════════════
//  МОДУЛЬ 4 — SMART MONEY (BOS/CHoCH + Liquidity Sweep)
// ══════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float swHigh = na
var float swLow  = na
if not na(ph)
    swHigh := ph
if not na(pl)
    swLow := pl

var int structBias = 0
if not na(swHigh) and close > swHigh
    structBias := 1
if not na(swLow) and close < swLow
    structBias := -1

bullSweep  = not na(swLow)  and low  < swLow  and close > swLow
bearSweep  = not na(swHigh) and high > swHigh and close < swHigh
sweepScore = bullSweep ? 1.0 : bearSweep ? -1.0 : 0.0

smcScore = clamp1(structBias * 0.7 + sweepScore * 0.3)

// ══════════════════════════════════════════════════════════════════════════════
//  ИТОГОВЫЙ СЧЁТ
// ══════════════════════════════════════════════════════════════════════════════
wSum = math.max(wTrend + wCorr + wMacro + wSMC, 0.0001)
raw  = (trendScore*wTrend + corrScore*wCorr + macroScore*wMacro + smcScore*wSMC) / wSum
score = nz0(raw) * 100.0                         // −100…+100, никогда не na

agree = (math.sign(trendScore)==math.sign(raw) and trendScore!=0 ? 1:0) +
        (math.sign(corrScore) ==math.sign(raw) and corrScore !=0 ? 1:0) +
        (math.sign(macroScore)==math.sign(raw) and macroScore!=0 ? 1:0) +
        (math.sign(smcScore)  ==math.sign(raw) and smcScore  !=0 ? 1:0)
confidence = math.round(math.min(100, math.abs(score)*0.6 + agree*10))

// ══════════════════════════════════════════════════════════════════════════════
//  СИГНАЛЫ (по закрытию бара, без перерисовки)
// ══════════════════════════════════════════════════════════════════════════════
var int state = 0
buy  = ta.crossover(score,  buyThr)  and confidence >= confMin and state <= 0
sell = ta.crossunder(score, sellThr) and confidence >= confMin and state >= 0
if buy
    state := 1
if sell
    state := -1

// ══════════════════════════════════════════════════════════════════════════════
//  ВИЗУАЛИЗАЦИЯ В ОТДЕЛЬНОЙ ПАНЕЛИ (overlay=false — score всегда виден!)
// ══════════════════════════════════════════════════════════════════════════════
// Заливка зон
hline( buyThr,  "Buy zone",  color=color.new(color.green,60), linestyle=hline.style_dashed)
hline( sellThr, "Sell zone", color=color.new(color.red,  60), linestyle=hline.style_dashed)
hline(0, "Zero", color=color.new(color.gray, 50))

// Гистограмма счёта (всегда видна)
scoreCol = score > 0 ? color.new(color.green, 20) : color.new(color.red, 20)
plot(score, "Счёт", color=scoreCol, style=plot.style_histogram, linewidth=3)
plot(score, "Линия счёта", color=scoreCol, linewidth=1)

// Стрелки сигналов
plotshape(buy,  "BUY",  shape.triangleup,   location.bottom, color.lime,  size=size.small)
plotshape(sell, "SELL", shape.triangledown, location.top,    color.red,   size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
//  МЕТКИ С УРОВНЯМИ (рисуем на score-панели)
// ══════════════════════════════════════════════════════════════════════════════
calcLevels(isBuy) =>
    entry = close
    sl    = isBuy ? entry - _atr*slMul : entry + _atr*slMul
    risk  = math.abs(entry - sl)
    tp1   = isBuy ? entry + risk*rr1 : entry - risk*rr1
    tp2   = isBuy ? entry + risk*rr2 : entry - risk*rr2
    bars  = _atr*moveEff > 0 ? math.round(risk*rr1 / (_atr*moveEff)) : 0
    [entry, sl, tp1, tp2, bars]

barsToStr(bars) =>
    sec   = bars * timeframe.in_seconds(timeframe.period)
    hours = sec / 3600.0
    hours < 1 ? str.tostring(math.round(sec/60)) + " мин" :
     hours < 48 ? str.tostring(math.round(hours,1)) + " ч" :
     str.tostring(math.round(hours/24,1)) + " дн"

if buy
    [en, sl, t1, t2, b] = calcLevels(true)
    txt = "▲ BUY\nВход : " + str.tostring(en, format.mintick) +
          "\nSL    : " + str.tostring(sl, format.mintick) +
          "\nTP1   : " + str.tostring(t1, format.mintick) +
          "\nTP2   : " + str.tostring(t2, format.mintick) +
          "\n⏱ ~"  + barsToStr(b) +
          "\n🎯 "  + str.tostring(confidence) + "%"
    label.new(bar_index, buyThr + 5, txt, style=label.style_label_up,
              color=color.new(color.green,10), textcolor=color.white, size=size.small)

if sell
    [en, sl, t1, t2, b] = calcLevels(false)
    txt = "▼ SELL\nВход : " + str.tostring(en, format.mintick) +
          "\nSL    : " + str.tostring(sl, format.mintick) +
          "\nTP1   : " + str.tostring(t1, format.mintick) +
          "\nTP2   : " + str.tostring(t2, format.mintick) +
          "\n⏱ ~"  + barsToStr(b) +
          "\n🎯 "  + str.tostring(confidence) + "%"
    label.new(bar_index, sellThr - 5, txt, style=label.style_label_down,
              color=color.new(color.red,10), textcolor=color.white, size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
//  ИНФОРМАЦИОННАЯ ПАНЕЛЬ
// ══════════════════════════════════════════════════════════════════════════════
sCol(s) => s > 0 ? color.new(color.green,50) : s < 0 ? color.new(color.red,50) : color.new(color.gray,50)
sTxt(s) => str.tostring(math.round(s*100))

if showTbl and barstate.islast
    var table p = table.new(position.top_right, 2, 7,
                            border_width=1, frame_color=color.gray, frame_width=1)
    biasLbl = score >= buyThr ? "ЛОНГ ▲" : score <= sellThr ? "ШОРТ ▼" : "НЕЙТРАЛ"
    biasCol = score >= buyThr ? color.green : score <= sellThr ? color.red : color.gray
    table.cell(p,0,0,"SMS PRO",     bgcolor=color.navy,     text_color=color.white, text_size=size.small)
    table.cell(p,1,0, biasLbl,      bgcolor=biasCol,        text_color=color.white, text_size=size.small)
    table.cell(p,0,1,"Счёт",        text_color=color.white, text_size=size.small)
    table.cell(p,1,1, str.tostring(math.round(score)) + " / 100",
                                    bgcolor=sCol(score),    text_color=color.white, text_size=size.small)
    table.cell(p,0,2,"Тренд",       text_color=color.white, text_size=size.small)
    table.cell(p,1,2, sTxt(trendScore), bgcolor=sCol(trendScore), text_color=color.white, text_size=size.small)
    table.cell(p,0,3,"Корреляция",  text_color=color.white, text_size=size.small)
    table.cell(p,1,3, sTxt(corrScore),  bgcolor=sCol(corrScore),  text_color=color.white, text_size=size.small)
    table.cell(p,0,4,"Макро",       text_color=color.white, text_size=size.small)
    table.cell(p,1,4, sTxt(macroScore), bgcolor=sCol(macroScore), text_color=color.white, text_size=size.small)
    table.cell(p,0,5,"Smart Money", text_color=color.white, text_size=size.small)
    table.cell(p,1,5, sTxt(smcScore),   bgcolor=sCol(smcScore),   text_color=color.white, text_size=size.small)
    table.cell(p,0,6,"Уверенность", text_color=color.white, text_size=size.small)
    table.cell(p,1,6, str.tostring(confidence) + "%",
                                    bgcolor=color.new(color.purple,50), text_color=color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
//  МУЛЬТИТАЙМФРЕЙМ
// ══════════════════════════════════════════════════════════════════════════════
simpleBias() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    r  = ta.rsi(close, rsiLen)
    s  = (close>ef?0.34:-0.34) + (ef>es?0.33:-0.33) + clamp1((r-50)/25)*0.33
    clamp1(s) * 100.0

b1 = request.security(syminfo.tickerid, tf1, simpleBias(), lookahead=barmerge.lookahead_off)
b2 = request.security(syminfo.tickerid, tf2, simpleBias(), lookahead=barmerge.lookahead_off)
b3 = request.security(syminfo.tickerid, tf3, simpleBias(), lookahead=barmerge.lookahead_off)
b4 = request.security(syminfo.tickerid, tf4, simpleBias(), lookahead=barmerge.lookahead_off)

mtfTxt(b) => nz0(b) > 20 ? "BUY ▲" : nz0(b) < -20 ? "SELL ▼" : "—"
mtfCol(b) => nz0(b) > 20 ? color.new(color.green,30) : nz0(b) < -20 ? color.new(color.red,30) : color.new(color.gray,50)

if showMTF and barstate.islast
    var table m = table.new(position.bottom_right, 2, 5,
                            border_width=1, frame_color=color.gray, frame_width=1)
    table.cell(m,0,0,"ТФ",    bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(m,1,0,"Сигнал",bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(m,0,1, tf1, text_color=color.white, text_size=size.small)
    table.cell(m,1,1, mtfTxt(b1), bgcolor=mtfCol(b1), text_color=color.white, text_size=size.small)
    table.cell(m,0,2, tf2, text_color=color.white, text_size=size.small)
    table.cell(m,1,2, mtfTxt(b2), bgcolor=mtfCol(b2), text_color=color.white, text_size=size.small)
    table.cell(m,0,3, tf3, text_color=color.white, text_size=size.small)
    table.cell(m,1,3, mtfTxt(b3), bgcolor=mtfCol(b3), text_color=color.white, text_size=size.small)
    table.cell(m,0,4, tf4, text_color=color.white, text_size=size.small)
    table.cell(m,1,4, mtfTxt(b4), bgcolor=mtfCol(b4), text_color=color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
//  АЛЕРТЫ
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(buy,  "BUY",  "SMS PRO: BUY {{ticker}} ({{interval}})")
alertcondition(sell, "SELL", "SMS PRO: SELL {{ticker}} ({{interval}})")
