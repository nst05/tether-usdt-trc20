<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TaxiAutoAccept" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/graphite</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
    </style>

    <!-- Карточка-секция: скруглённая, без тяжёлой тени, с ровными отступами. -->
    <style name="Card.Section" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Text.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Hint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:alpha">0.7</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
</resources>
