//@version=5
indicator(title="Smart Money Concepts Pro", shorttitle="SMC Pro", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════ INPUTS ═══════════════════════════════════════════════════

g1 = "📐 Structure"
showBOS = input.bool(true,  "BOS / CHoCH",        group=g1)
showSW  = input.bool(true,  "Swing H/L markers",  group=g1)
swLen   = input.int(7,      "Swing Lookback",      minval=3, maxval=50, group=g1)
bullCol = input.color(#26A69A, "Bull colour",      group=g1)
bearCol = input.color(#EF5350, "Bear colour",      group=g1)

g2 = "📦 Order Blocks"
showOB  = input.bool(true,  "Order Blocks",        group=g2)
obLen   = input.int(7,      "OB Lookback",         minval=3, maxval=50, group=g2)
mitOB   = input.bool(true,  "Hide mitigated OBs",  group=g2)
bullOBF = input.color(color.new(#26A69A, 80), "Bull OB fill",   group=g2)
bearOBF = input.color(color.new(#EF5350, 80), "Bear OB fill",   group=g2)
bullOBB = input.color(#26A69A, "Bull OB border",   group=g2)
bearOBB = input.color(#EF5350, "Bear OB border",   group=g2)

g3 = "⚡ Fair Value Gaps"
showFVG = input.bool(true,  "FVG Zones",           group=g3)
bullFVGF= input.color(color.new(#26A69A, 85), "Bull FVG fill",  group=g3)
bearFVGF= input.color(color.new(#EF5350, 85), "Bear FVG fill",  group=g3)
hideFVG = input.bool(true,  "Hide filled FVGs",    group=g3)

g4 = "💧 Liquidity"
showLiq = input.bool(true,  "EQH / EQL lines",     group=g4)
liqLen  = input.int(10,     "Lookback",            minval=5, maxval=100, group=g4)
liqPct  = input.float(0.1,  "Equal threshold %",   minval=0.01, step=0.01, group=g4)

g5 = "🎯 Premium / Discount"
showPD  = input.bool(true,  "P/D Zones",           group=g5)
pdLen   = input.int(50,     "Range Lookback",      minval=10, group=g5)
premF   = input.color(color.new(#EF5350, 88), "Premium fill",  group=g5)
equiF   = input.color(color.new(#FFEB3B, 88), "Equi fill",     group=g5)
discF   = input.color(color.new(#26A69A, 88), "Discount fill", group=g5)

g6 = "📊 Volume"
showVD  = input.bool(true,  "Volume-delta colours", group=g6)
volMAL  = input.int(20,     "Vol MA length",        minval=5, group=g6)

// ═══════ HELPERS ══════════════════════════════════════════════════

atr14 = ta.atr(14)

// ═══════ PIVOTS ═══════════════════════════════════════════════════

ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow (low,  swLen, swLen)

var float swH = na,  var int swHBar = na
var float swL = na,  var int swLBar = na
var float pswH = na, var int pswHBar = na
var float pswL = na, var int pswLBar = na

if not na(ph)
    pswH    := swH
    pswHBar := swHBar
    swH     := ph
    swHBar  := bar_index - swLen

if not na(pl)
    pswL    := swL
    pswLBar := swLBar
    swL     := pl
    swLBar  := bar_index - swLen

// ═══════ 1. SWING MARKERS ═════════════════════════════════════════

if showSW
    if not na(ph)
        label.new(bar_index - swLen, ph, "H", style=label.style_label_down, color=bearCol, textcolor=color.white, size=size.tiny)
    if not na(pl)
        label.new(bar_index - swLen, pl, "L", style=label.style_label_up, color=bullCol, textcolor=color.white, size=size.tiny)

// ═══════ 2. BOS / CHoCH ═══════════════════════════════════════════

var bool  isBull = true
var float wH = na, var int wHBar = na
var float wL = na, var int wLBar = na

if not isBull and not na(ph)
    wH    := ph
    wHBar := bar_index - swLen
if isBull and not na(pl)
    wL    := pl
    wLBar := bar_index - swLen

bosBull = not isBull and not na(wH)   and ta.crossover (close, wH)
bosBear = isBull     and not na(wL)   and ta.crossunder(close, wL)
chBull  = not isBull and not na(pswH) and ta.crossover (close, pswH)
chBear  = isBull     and not na(pswL) and ta.crossunder(close, pswL)

// Save draw values BEFORE resetting wH/wL
bosBlvl  = bosBull ? wH   : na
bosBbar  = bosBull ? wHBar : na
bosSlvl  = bosBear ? wL   : na
bosSbar  = bosBear ? wLBar : na
chBlvl   = chBull  ? pswH  : na
chBbar   = chBull  ? pswHBar : na
chSlvl   = chBear  ? pswL  : na
chSbar   = chBear  ? pswLBar : na

if bosBull or chBull
    isBull := true
    wH     := na
if bosBear or chBear
    isBull := false
    wL     := na

if showBOS
    if bosBull and not na(bosBbar)
        line.new(bosBbar, bosBlvl, bar_index, bosBlvl, color=bullCol, width=1, style=line.style_dashed)
        label.new(bar_index, bosBlvl, "BOS", style=label.style_none, textcolor=bullCol, size=size.small)
    if bosBear and not na(bosSbar)
        line.new(bosSbar, bosSlvl, bar_index, bosSlvl, color=bearCol, width=1, style=line.style_dashed)
        label.new(bar_index, bosSlvl, "BOS", style=label.style_none, textcolor=bearCol, size=size.small)
    if chBull and not na(chBbar)
        line.new(chBbar, chBlvl, bar_index, chBlvl, color=bullCol, width=2)
        label.new(bar_index, chBlvl, "CHoCH", style=label.style_none, textcolor=bullCol, size=size.small)
    if chBear and not na(chSbar)
        line.new(chSbar, chSlvl, bar_index, chSlvl, color=bearCol, width=2)
        label.new(bar_index, chSlvl, "CHoCH", style=label.style_none, textcolor=bearCol, size=size.small)

// ═══════ 3. ORDER BLOCKS ══════════════════════════════════════════

obPH = ta.pivothigh(high, obLen, obLen)
obPL = ta.pivotlow (low,  obLen, obLen)

var box[] bullOBs = array.new_box()
var box[] bearOBs = array.new_box()

if showOB
    if not na(obPH)
        array.push(bearOBs, box.new(bar_index - obLen, high[obLen], bar_index + 50, math.min(open[obLen], close[obLen]), bgcolor=bearOBF, border_color=bearOBB, border_width=1))
    if not na(obPL)
        array.push(bullOBs, box.new(bar_index - obLen, math.max(open[obLen], close[obLen]), bar_index + 50, low[obLen], bgcolor=bullOBF, border_color=bullOBB, border_width=1))

if showOB
    n1 = array.size(bearOBs)
    if n1 > 0
        for i = n1 - 1 to 0
            bx = array.get(bearOBs, i)
            if mitOB and close > box.get_top(bx)
                box.set_right(bx, bar_index)
                array.remove(bearOBs, i)
            else
                box.set_right(bx, bar_index + 50)
    n2 = array.size(bullOBs)
    if n2 > 0
        for i = n2 - 1 to 0
            bx = array.get(bullOBs, i)
            if mitOB and close < box.get_bottom(bx)
                box.set_right(bx, bar_index)
                array.remove(bullOBs, i)
            else
                box.set_right(bx, bar_index + 50)

// ═══════ 4. FAIR VALUE GAPS ═══════════════════════════════════════

var box[] bFVG  = array.new_box()
var box[] brFVG = array.new_box()

if showFVG
    if low > high[2]
        array.push(bFVG, box.new(bar_index - 2, low, bar_index + 80, high[2], bgcolor=bullFVGF, border_color=color.new(#26A69A, 50), border_width=1))
    if high < low[2]
        array.push(brFVG, box.new(bar_index - 2, low[2], bar_index + 80, high, bgcolor=bearFVGF, border_color=color.new(#EF5350, 50), border_width=1))

if showFVG
    n3 = array.size(bFVG)
    if n3 > 0
        for i = n3 - 1 to 0
            bx = array.get(bFVG, i)
            if hideFVG and low <= box.get_bottom(bx)
                box.set_right(bx, bar_index)
                array.remove(bFVG, i)
            else
                box.set_right(bx, bar_index + 80)
    n4 = array.size(brFVG)
    if n4 > 0
        for i = n4 - 1 to 0
            bx = array.get(brFVG, i)
            if hideFVG and high >= box.get_top(bx)
                box.set_right(bx, bar_index)
                array.remove(brFVG, i)
            else
                box.set_right(bx, bar_index + 80)

// ═══════ 5. EQH / EQL ═════════════════════════════════════════════

if showLiq
    phC  = not na(ta.pivothigh(high, liqLen, liqLen))
    plC  = not na(ta.pivotlow (low,  liqLen, liqLen))
    cph  = ta.valuewhen(phC, high[liqLen],       0)
    pph  = ta.valuewhen(phC, high[liqLen],       1)
    cphB = ta.valuewhen(phC, bar_index - liqLen, 0)
    pphB = ta.valuewhen(phC, bar_index - liqLen, 1)
    cpl  = ta.valuewhen(plC, low[liqLen],        0)
    ppl  = ta.valuewhen(plC, low[liqLen],        1)
    cplB = ta.valuewhen(plC, bar_index - liqLen, 0)
    pplB = ta.valuewhen(plC, bar_index - liqLen, 1)
    if phC and not na(pph) and not na(cph)
        if math.abs(cph - pph) / pph * 100 <= liqPct
            line.new(pphB, cph, bar_index, cph, color=bearCol, width=1, style=line.style_dotted)
            label.new(bar_index, cph, "EQH", style=label.style_none, textcolor=bearCol, size=size.tiny)
    if plC and not na(ppl) and not na(cpl)
        if math.abs(cpl - ppl) / ppl * 100 <= liqPct
            line.new(pplB, cpl, bar_index, cpl, color=bullCol, width=1, style=line.style_dotted)
            label.new(bar_index, cpl, "EQL", style=label.style_none, textcolor=bullCol, size=size.tiny)

// ═══════ 6. PREMIUM / DISCOUNT ════════════════════════════════════

highH   = ta.highest(high, pdLen)
lowL    = ta.lowest (low,  pdLen)
rng     = highH - lowL
premLvl = lowL + rng * 0.618
discLvl = lowL + rng * 0.382
eqLvl   = lowL + rng * 0.500

// Shaded boxes spanning the full lookback range + 30 bars right
var box premBox = na
var box equiBox = na
var box discBox = na

if showPD
    rLeft = bar_index - pdLen
    if na(premBox)
        premBox := box.new(rLeft, highH,   bar_index + 30, premLvl, bgcolor=premF, border_color=color.new(#EF5350, 60), border_width=1)
        equiBox := box.new(rLeft, premLvl, bar_index + 30, discLvl, bgcolor=equiF, border_color=color.new(#FFEB3B, 60), border_width=1)
        discBox := box.new(rLeft, discLvl, bar_index + 30, lowL,    bgcolor=discF, border_color=color.new(#26A69A, 60), border_width=1)
    else
        box.set_left  (premBox, rLeft)
        box.set_top   (premBox, highH)
        box.set_right (premBox, bar_index + 30)
        box.set_bottom(premBox, premLvl)
        box.set_left  (equiBox, rLeft)
        box.set_top   (equiBox, premLvl)
        box.set_right (equiBox, bar_index + 30)
        box.set_bottom(equiBox, discLvl)
        box.set_left  (discBox, rLeft)
        box.set_top   (discBox, discLvl)
        box.set_right (discBox, bar_index + 30)
        box.set_bottom(discBox, lowL)

// Always-visible level lines (plot works even when boxes are off)
plot(showPD ? premLvl : na, "Premium 61.8%",  color=color.new(#EF5350, 20), linewidth=1)
plot(showPD ? eqLvl   : na, "Equilib. 50%",   color=color.new(#FFEB3B, 20), linewidth=1)
plot(showPD ? discLvl : na, "Discount 38.2%", color=color.new(#26A69A, 20), linewidth=1)

// ═══════ 7. VOLUME DELTA BAR COLOUR ══════════════════════════════

delta   = volume * (close - open) / math.max(high - low, syminfo.mintick)
volMA   = ta.sma(volume, volMAL)
highVol = volume > volMA * 1.5

var color bCol = color.gray
if showVD
    if delta > 0 and highVol
        bCol := color.new(#00E676, 0)
    else if delta > 0
        bCol := color.new(#26A69A, 30)
    else if delta < 0 and highVol
        bCol := color.new(#FF1744, 0)
    else if delta < 0
        bCol := color.new(#EF5350, 30)
    else
        bCol := color.new(#888888, 50)
else
    bCol := na

barcolor(bCol)

// ═══════ 8. DASHBOARD ═════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(#0D0D1A, 5), border_color=color.new(#444444, 0), border_width=1, frame_color=color.new(#666666, 0), frame_width=1)

fibPct = rng > 0 ? (close - lowL) / rng * 100 : 50.0
volRat = volume / math.max(volMA, 1)

var string zTxt = "EQUILIBRIUM"
var color  zClr = color.new(#FFEB3B, 0)
if fibPct >= 61.8
    zTxt := "PREMIUM"
    zClr := color.new(#EF5350, 0)
else if fibPct >= 38.2
    zTxt := "EQUILIBRIUM"
    zClr := color.new(#FFEB3B, 0)
else
    zTxt := "DISCOUNT"
    zClr := color.new(#26A69A, 0)

var string vTxt = ""
var color  vClr = color.white
if volRat >= 1.5
    vTxt := "HIGH " + str.tostring(math.round(volRat, 1)) + "x"
    vClr := color.new(#FFEB3B, 0)
else if volRat >= 1.0
    vTxt := "AVG  " + str.tostring(math.round(volRat, 1)) + "x"
    vClr := color.white
else
    vTxt := "LOW  " + str.tostring(math.round(volRat, 1)) + "x"
    vClr := color.new(#888888, 0)

var string sTxt = "-"
var color  sClr = color.new(#888888, 0)
if bosBull or chBull
    sTxt := "Bull break"
    sClr := bullCol
else if bosBear or chBear
    sTxt := "Bear break"
    sClr := bearCol
else
    sTxt := "-"
    sClr := color.new(#888888, 0)

var string dTxt = "Neutral"
var color  dClr = color.new(#888888, 0)
if delta > 0
    dTxt := "Buy pressure"
    dClr := bullCol
else if delta < 0
    dTxt := "Sell pressure"
    dClr := bearCol
else
    dTxt := "Neutral"
    dClr := color.new(#888888, 0)

tTxt = isBull ? "BULLISH" : "BEARISH"
tClr = isBull ? bullCol   : bearCol

if barstate.islast
    table.cell(dash, 0, 0, "SMC PRO", text_color=color.white, text_size=size.normal, bgcolor=color.new(#3949AB, 10))
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.new(#AAAAAA, 0), text_size=size.small, bgcolor=color.new(#3949AB, 10))
    table.cell(dash, 0, 1, "Trend",  text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, tTxt,     text_color=tClr,        text_size=size.small)
    table.cell(dash, 0, 2, "Zone",   text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, zTxt,     text_color=zClr,        text_size=size.small)
    table.cell(dash, 0, 3, "Fib %",  text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(fibPct, 1)) + "%", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Volume", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, vTxt,     text_color=vClr,        text_size=size.small)
    table.cell(dash, 0, 5, "ATR 14", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(math.round(atr14, 4)), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "BOS",    text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, sTxt,     text_color=sClr,        text_size=size.small)
    table.cell(dash, 0, 7, "Delta",  text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, dTxt,     text_color=dClr,        text_size=size.small)

// ═══════ 9. ALERTS ════════════════════════════════════════════════

alertcondition(bosBull, "BOS Bull",  "SMC: Bullish Break of Structure")
alertcondition(bosBear, "BOS Bear",  "SMC: Bearish Break of Structure")
alertcondition(chBull,  "CHoCH Bull","SMC: Bullish Change of Character")
alertcondition(chBear,  "CHoCH Bear","SMC: Bearish Change of Character")
alertcondition(not na(obPL) and showOB, "Bull OB", "SMC: Bull Order Block formed")
alertcondition(not na(obPH) and showOB, "Bear OB", "SMC: Bear Order Block formed")
alertcondition(low > high[2], "Bull FVG", "SMC: Bullish Fair Value Gap")
alertcondition(high < low[2], "Bear FVG", "SMC: Bearish Fair Value Gap")
